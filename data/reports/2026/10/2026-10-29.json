      "title": "Proactive Memory for Event-Driven LLM Agents",
      "category": "2.3",
      "tags": [
        "Proactive Agents",
        "Temporal Memory",
        "Evidence Validation"
      ],
      "published_on": "2026-10-27",
      "first_seen_at": "2026-10-28T10:04:45.988+00:00",
      "canonical_url": "https://arxiv.org/abs/2610.36967",
      "links": {
        "paper": "https://arxiv.org/html/2610.36967v1"
      },
      "summary": [
        "ProactMem organizes an event stream into recent observations, source-checked activity trajectories and behavioral regularities admitted through historical replay.",
        "Matching those regularities to current conditions helps an agent decide when to offer assistance while suppressing redundant proposals."
      ],
      "evidence": {
        "type": "research-paper",
        "access": "full-text",
        "rationale": "Sections 3–5 and Appendices B–D: on 4,539 events from 17 isolated Sports/Home/Code streams, pooled F1 is 52.6%, 21.4% relatively above the strongest of five external baselines with GPT-5.6 Luna. Source-validation and replay ablations lower F1. Editorial catch-up from the October 28 screened reserve; the original paper announcement was October 28, not a new October 29 release.",
        "limitations": "Method and benchmark were jointly developed without independent held-out evaluation. Separate-team labels lower Home/Code diagnostic scores, and controllers differ with memory representations. Offline opportunity detection does not measure recipient benefit, interruption cost or safety. Anonymous implementation contents and their earlier visibility could not be verified."
      },
      "novelty": "newly-discovered"
    },
