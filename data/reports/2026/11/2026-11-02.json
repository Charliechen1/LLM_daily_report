  "entries": [
    {
      "id": "arxiv:2611.02017",
      "title": "Switch-SWE: Do Coding Agents Hold Focus When Switching Between Unfinished Tasks?",
      "category": "2.8",
      "tags": [
        "Task Switching",
        "Coding Agents",
        "Context Management"
      ],
      "published_on": "2026-11-01",
      "first_seen_at": "2026-11-09T11:06:58.499+00:00",
      "canonical_url": "https://arxiv.org/abs/2611.02017",
      "links": {
        "paper": "https://arxiv.org/pdf/2611.02017v1",
        "code": "https://github.com/Miraclecsc/Switch-SWE"
      },
      "summary": [
        "Switch-SWE pairs uninterrupted coding with sessions that repeatedly interleave five unfinished tasks in separate persistent workspaces, exposing failures when agents resume earlier work.",
        "Its context manager restores task-relevant history and compact state, suggesting a concrete way to reduce resumption failures without changing the coding model."
      ],
      "evidence": {
        "type": "research-paper",
        "access": "full-text",
        "rationale": "V1 study, resource accounting and RCM appendices inspected. On 200 paired focus tasks, seven model–harness configurations lose 6–15 percentage points under switching; OpenCode RCM raises switched resolution from 31.5% to 47.0% and from 43.0% to 48.5% for two models. The November 1 replacement adds the frozen same-repository 200-pair study and RCM to a May cross-repository draft. Retrospective November 2 catch-up retains that release date.",
        "limitations": "One paired run per configuration and diagnostically selected tasks constrain inference. Focus budgets match, but switched sessions contain additional work; token multipliers are not pure switching overhead. Public code exposes 200 switched tasks and the plugin, rather than verified complete paired-control artifacts. No independent reproduction."
      },
      "novelty": "newly-discovered"
    }
  ]
}
