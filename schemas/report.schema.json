{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charliechen1/LLM_daily_report/blob/main/schemas/report.schema.json",
  "title": "LLM Research Report or Landscape",
  "$comment": "The zero-dependency CLI enforces this shape and additional calendar, taxonomy, schedule, placeholder, English, source availability and cross-report deduplication rules. Sentence boundaries and factual quality require human review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "timezone", "generated_at", "search", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["daily", "landscape"] },
    "overview": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } },
    "date": { "$ref": "#/$defs/date" },
    "timezone": { "const": "America/Los_Angeles" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/timestamp" }, "end": { "$ref": "#/$defs/timestamp" } }
    },
    "search": {
      "type": "object", "additionalProperties": false, "required": ["status", "notes", "sources_checked"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "notes": { "type": "string" },
        "sources_checked": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "url", "status"],
            "properties": { "name": { "$ref": "#/$defs/text" }, "url": { "$ref": "#/$defs/https" }, "status": { "enum": ["ok", "unavailable"] } }
          },
          "contains": { "type": "object", "properties": { "status": { "const": "ok" } }, "required": ["status"] }
        }
      },
      "allOf": [{ "if": { "properties": { "status": { "const": "partial" } } }, "then": { "properties": { "notes": { "$ref": "#/$defs/text" } } } }]
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "allOf": [{
    "if": { "required": ["kind"], "properties": { "kind": { "const": "landscape" } } },
    "then": { "not": { "required": ["coverage"] }, "properties": { "entries": { "minItems": 1, "items": { "required": ["positioning"], "properties": { "novelty": { "const": "baseline" } } } } } },
    "else": { "required": ["coverage"], "not": { "required": ["overview"] }, "properties": { "entries": { "maxItems": 10, "items": { "properties": { "novelty": { "enum": ["new", "newly-discovered", "material-update"] } } } } } }
  }],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:0\\d|1[0-4]):[0-5]\\d)$" },
    "https": { "type": "string", "format": "uri", "pattern": "^https://[^/\\s]+" },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "category", "tags", "published_on", "first_seen_at", "canonical_url", "links", "summary", "evidence", "novelty"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]*$" },
        "title": { "$ref": "#/$defs/text" },
        "category": { "enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7", "1.8", "1.9", "1.10", "2.1", "2.2", "2.3", "2.4", "2.5", "2.6", "2.7", "2.8", "3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.7", "3.8"] },
        "tags": { "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "published_on": { "$ref": "#/$defs/date" },
        "first_seen_at": { "$ref": "#/$defs/timestamp" },
        "canonical_url": { "$ref": "#/$defs/https" },
        "links": {
          "type": "object", "additionalProperties": false,
          "properties": { "paper": { "$ref": "#/$defs/https" }, "blog": { "$ref": "#/$defs/https" }, "code": { "$ref": "#/$defs/https" }, "project": { "$ref": "#/$defs/https" } }
        },
        "summary": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/text" } },
        "evidence": {
          "type": "object", "additionalProperties": false, "required": ["type", "access", "rationale", "limitations"],
          "properties": {
            "type": { "enum": ["research-paper", "technical-report", "engineering-report"] },
            "access": { "enum": ["full-text", "abstract-only"] },
            "rationale": { "$ref": "#/$defs/text" },
            "limitations": { "$ref": "#/$defs/text" }
          }
        },
        "novelty": { "enum": ["new", "newly-discovered", "material-update", "baseline"] },
        "positioning": { "enum": ["frontier-research", "established-method", "open-reference"] },
        "update_note": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "if": { "properties": { "novelty": { "const": "material-update" } } }, "then": { "required": ["update_note"] } }]
    }
  }
}
